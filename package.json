{
  "name": "splatnet3-wiki",
  "devDependencies": {
    "mermaid": "^11",
    "minisearch": "7.1.2",
    "prettier": "3.9.10",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vue": "3.5.22",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.11",
  "private": true,
  "scripts": {
    "test": "bun test tests/*.test.ts",
    "format:md": "prettier --write '**/*.md'",
    "format:md:check": "prettier --check '**/*.md'",
    "docs:dev": "vitepress dev . --host 127.0.0.1 --port 4173 --strictPort",
    "docs:build": "vitepress build .",
    "docs:preview": "vitepress preview .",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "type": "module"
}
